# SECURITY SETTINGS
# Generate a strong random secret key for production
# Example: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=dev-insecure-secret-key-only-for-local-development

# Set to false in production to disable detailed error pages
DEBUG=true

# GENERAL SETTINGS
# JSON array of allowed hostnames
ALLOWED_HOSTS='["todo.film", "localhost"]'

# KINOPOISK API (REQUIRED)
# Get your token from https://kinopoiskapiunofficial.tech
KINOPOISK_TOKEN=your-api-key-here

# Optional: override default Kinopoisk API base URL
KINOPOISK_API_URL=https://kinopoiskapiunofficial.tech

# Maximum number of search results per API request
MAX_COUNT_MOVIE_PER_REQUEST=15

# ADMIN USER (optional - created on first migration if all three are set)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin
ADMIN_EMAIL=admin@localhost.local

# DATABASE CONFIGURATION (PostgreSQL 16)
# Host: use 'postgresdb' inside Docker Compose
POSTGRES_HOST=postgresdb

# Database user (created by Docker image)
POSTGRES_USER=film_todo

# Database password (MUST be changed from default!)
# Use a strong password: 20+ chars with uppercase, lowercase, numbers, symbols
POSTGRES_PASSWORD=change-me-in-local-env

# Database name
POSTGRES_DATABASE_NAME=film_todo

# Enable TLS for database connections (set to true in production)
POSTGRES_USE_TLS=false

# Separate database for running tests (auto-created)
TEST_POSTGRES_DATABASE_NAME=film_todo_test
